#!/usr/bin/env -S bash -ec 'd=${0%/*};r=$d/.pkl-nix-tools;test ! -L "$r";test -f "$r/run"||{ mkdir -p "$r";echo "*" >"$r/.gitignore";pkl eval -w "$d" -x launcher flake.pkl -o ".pkl-nix-tools/run.$$";mv "$r/run.$$" "$r/run";};exec bash "$r/run" "$0" "$@"'
amends "../Flake.pkl"

import "../Nix.pkl" as Nix

local launcher = import("@nixTools/Bootstrap.pkl").output.text

description = "A minimal Pkl flake"

inputs {
  ["nixpkgs"] = new Nix.Input {
    url = "github:NixOS/nixpkgs/nixos-unstable"
  }
}

packages {
  ["x86_64-linux"] {
    ["hello"] = new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux.hello" }
  }
}

apps {
  ["x86_64-linux"] {
    ["hello"] = new Nix.App {
      program = new Nix.InterpolatedString {
        parts {
          new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux.hello" }
          "/bin/hello"
        }
      }
    }
  }
}
