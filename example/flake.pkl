#!/usr/bin/env -S pkl eval
amends "../Flake.pkl"

import "../Nix.pkl" as Nix

description = "A minimal Pkl flake"

inputs {
  ["nixpkgs"] = new Nix.Input {
    url = "github:NixOS/nixpkgs/nixos-unstable"
  }
}

packages {
  ["x86_64-linux"] {
    ["hello"] = new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux.hello" }
  }
}

apps {
  ["x86_64-linux"] {
    ["hello"] = new Nix.App {
      program = new Nix.InterpolatedString {
        parts {
          new Nix.Ref { path = "inputs.nixpkgs.legacyPackages.x86_64-linux.hello" }
          "/bin/hello"
        }
      }
    }
  }
}
